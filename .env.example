# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional alternative providers. Any one of them is enough — the app
# falls back to the local compiler when no key is configured.
#   OPENAI_API_KEY     - platform.openai.com (starts with sk-)
#   ANTHROPIC_API_KEY  - console.anthropic.com (starts with sk-ant-)
#   NVIDIA_API_KEY     - build.nvidia.com, OpenAI-compatible NIM endpoint (starts with nvapi-)
#   OPENROUTER_API_KEY - openrouter.ai, OpenAI-compatible gateway (starts with sk-or-)
#   GROQ_API_KEY       - console.groq.com, OpenAI-compatible host (starts with gsk_)
# Keys can also be pasted right in the app: sidebar (bottom-left) → «Ключи API».

# Optional: how long the server waits for an AI provider before falling back to the
# local compiler (milliseconds). AI_REQUEST_TIMEOUT_MS applies to one model, while
# AI_TOTAL_BUDGET_MS is shared by every candidate model of a provider.
# A real compiler-sized prompt currently takes about a minute on NVIDIA NIM, so keep
# the per-model limit above that unless your account serves a faster model.
AI_REQUEST_TIMEOUT_MS=120000
AI_TOTAL_BUDGET_MS=150000

# Optional: the answer ceiling asked of every provider, in tokens. A change set that
# carries complete files is large, and a low ceiling cuts it in the middle of a file.
# Nothing above a model's own maximum is accepted, so raise this only for a model that
# takes it. When a provider reports that it hit this limit, the finished part of the
# answer is kept instead of being thrown away.
AI_MAX_OUTPUT_TOKENS=16000
